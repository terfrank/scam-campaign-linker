# Copy to .env and change the password. .env is git-ignored.

# Used by docker-compose to create the database
POSTGRES_USER=scam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scam_linker

# Used by the app when you run it outside Docker (inside Docker, compose overrides it)
DATABASE_URL=postgresql+psycopg://scam:change-me@localhost:5432/scam_linker
LOG_LEVEL=INFO
